# Copy to .env and fill with your own values (.env is gitignored)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID

# Monitored source (its sitemap is used for catalog discovery)
SUPPLIER_BASE_URL=

# Timezone of the monitored market
TZ_NAME=Europe/Kyiv

# Storage + localized text
DB_NAME=monitor.db
LOCALE_FILE=locale.local.json
FETCH_WORKERS=10
RETAIN_DAYS=3
